<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for distribution: one self-contained exe, no .NET installation needed on the target PC.
  Only what the app needs is included: English resources only, native libraries bundled and compressed.
  Trimming is not possible: Windows Forms and the COM interop of UI Automation do not support it.
  Usage: dotnet publish MCPServer -c Release -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\publish\</PublishDir>
  </PropertyGroup>
</Project>
